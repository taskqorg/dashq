# Reviewed dash. site (dashq.md D3/D11, docs/design/enrollment.md C3). The Langfuse UI guard covers every path
# except POST under /machine/, the machine routes, which carry their own pairing or device authorization.
dash.example.com {
	# a client never supplies the identity or address dashq trusts
	request_header -X-Dashq-Subject
	request_header -X-Dashq-Client
	@machine {
		method POST
		path /machine/*
	}
	route {
		handle @machine {
			reverse_proxy 127.0.0.1:18882 {
				header_up X-Dashq-Client {client_ip}
			}
		}
		forward_auth 127.0.0.1:9121 {
			uri /verify
			header_up -Upgrade
			header_up -Connection
			# the guard's verified provider subject; qualify the source header name before release (#4)
			copy_headers X-Auth-Subject>X-Dashq-Subject
		}
		reverse_proxy 127.0.0.1:18882
	}
}
