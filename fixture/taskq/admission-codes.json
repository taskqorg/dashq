{
  "codes": [
    {
      "code": "admitted",
      "meaning": "this host claimed the task in this pass"
    },
    {
      "code": "dependency",
      "meaning": "a Depends on issue is open or unknown"
    },
    {
      "code": "hold",
      "meaning": "an emergency hold, draining, a pending restart or an older service holds launches"
    },
    {
      "code": "host",
      "meaning": "a host-* label, a labelled claim or assignee-only assigns the task to another host"
    },
    {
      "code": "capability",
      "meaning": "a needs-* label or the routed runtime is not available on this host"
    },
    {
      "code": "labels",
      "meaning": "the task labels are invalid; no host admits it"
    },
    {
      "code": "focus",
      "meaning": "the host focus excludes the task or admits nothing"
    },
    {
      "code": "capacity",
      "meaning": "runtime, project or host slots are full or another project has the turn"
    },
    {
      "code": "load-gate",
      "meaning": "the load gate or launch spacing holds launches"
    },
    {
      "code": "login",
      "meaning": "the routed runtime is not logged in"
    },
    {
      "code": "usage-limit",
      "meaning": "the routed runtime is held after a usage limit"
    },
    {
      "code": "access",
      "meaning": "the routed runtime refused its access grant"
    },
    {
      "code": "unknown",
      "meaning": "no decision is known; reason names why"
    }
  ],
